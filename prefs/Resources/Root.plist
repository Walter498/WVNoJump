<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>通用</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>启用</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>支持的输入法</string>
			<key>footerText</key><string>未安装的输入法会自动隐藏。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>微信输入法</string>
			<key>bundleID</key><string>com.tencent.wetype</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsWeTypeEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>百度输入法</string>
			<key>bundleID</key><string>com.baidu.inputMethod</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsBaiduEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>搜狗输入法</string>
			<key>bundleID</key><string>com.sogou.sogouinput</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsSogouEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>讯飞输入法</string>
			<key>bundleID</key><string>com.iflytek.inputime</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsXunFeiEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>豆包输入法</string>
			<key>bundleID</key><string>com.bytedance.ios.doubaoime</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsDoubaoEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Typeless 输入法</string>
			<key>bundleID</key><string>com.typeless.mobile</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsTypelessEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>其他输入法</string>
			<key>footerText</key><string>开启后，任何「自带键盘扩展」的输入法（如 Typeless、Wispr Flow、声印、ninan、懒懒键盘等）都会被自动识别，无需单独适配。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>自动识别其他输入法（通用模式）</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsGenericEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>记录跳转日志（排查用）</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>IsDebugLogEnabled</string>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string></string>
			<key>footerText</key><string>日志路径：/var/mobile/Library/Logs/WVNoJump.log（只在有 App 深链跳转时记录一行）。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>快照淡出动画</string>
			<key>footerText</key><string>跳转瞬间会把原 App 画面冻结盖住，这里控制它淡出的延时与时长。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>延迟时间</string>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>AnimationDelay</string>
			<key>default</key><integer>300</integer>
			<key>min</key><integer>0</integer>
			<key>max</key><integer>900</integer>
			<key>isSegmented</key><true/>
			<key>segmentCount</key><integer>9</integer>
			<key>showValue</key><true/>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>持续时间</string>
			<key>defaults</key><string>com.walter.voicenojump</string>
			<key>key</key><string>AnimationInterval</string>
			<key>default</key><integer>300</integer>
			<key>min</key><integer>0</integer>
			<key>max</key><integer>900</integer>
			<key>isSegmented</key><true/>
			<key>segmentCount</key><integer>9</integer>
			<key>showValue</key><true/>
			<key>PostNotification</key><string>com.walter.voicenojump/saved</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string></string>
			<key>footerText</key><string>机制逆向自 Lessica「语音转文字免跳转」1.2</string>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>关于 / 反馈</string>
			<key>action</key><string>about</string>
		</dict>
	</array>
	<key>title</key>
	<string>语音转文字免跳转</string>
</dict>
</plist>
